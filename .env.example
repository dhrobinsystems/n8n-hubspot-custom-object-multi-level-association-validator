# ─────────────────────────────────────────────────────────────────────────────
# n8n-hubspot-custom-object-multi-level-association-validator — env template
# Copy to .env (never commit .env). Every value below is a PLACEHOLDER.
# Safe defaults: with these values the workflow audits a synthetic fixture,
# changes nothing in HubSpot and sends nothing to Slack.
# ─────────────────────────────────────────────────────────────────────────────

# ── Safety flags (leave as-is until staging is verified) ─────────────────────
SANDBOX_MODE=true
DRY_RUN=true
HUBSPOT_MUTATIONS_ENABLED=false
SEND_SLACK_ALERTS=false
SEND_OPS_ALERTS=false

# ── HubSpot private app (crm.objects.custom.read, crm.objects.custom.write, crm.schemas.custom.read)
HUBSPOT_ACCESS_TOKEN=replace-with-hubspot-private-app-token
HUBSPOT_PORTAL_ID=99000001
HUBSPOT_APP_BASE_URL=https://app.hubspot.com

# ── Hierarchy: Parent → Child → Asset custom object types (placeholders) ─────
HUBSPOT_PARENT_OBJECT_TYPE=p99000001_parent_account
HUBSPOT_PARENT_OBJECT_TYPE_ID=2-99000101
HUBSPOT_CHILD_OBJECT_TYPE=p99000001_child_project
HUBSPOT_CHILD_OBJECT_TYPE_ID=2-99000102
HUBSPOT_ASSET_OBJECT_TYPE=p99000001_asset_unit
HUBSPOT_ASSET_OBJECT_TYPE_ID=2-99000103
PARENT_LABEL=Parent
CHILD_LABEL=Child
ASSET_LABEL=Asset

# ── Association definitions (mock type IDs; "UP" = lower → upper) ────────────
PARENT_CHILD_UP_TYPE_ID=901
PARENT_CHILD_DOWN_TYPE_ID=902
CHILD_ASSET_UP_TYPE_ID=903
CHILD_ASSET_DOWN_TYPE_ID=904
ASSOCIATION_CATEGORY=USER_DEFINED
MAX_PARENTS_PER_CHILD=1
MAX_CHILDREN_PER_ASSET=1
REQUIRE_PARENT_FOR_CHILD=true
REQUIRE_CHILD_FOR_ASSET=true
STRICT_ASSOCIATION_TYPES=true
CHECK_BIDIRECTIONAL_ASSOCIATIONS=true
FLAG_EMPTY_PARENTS=true

# ── Record properties used for names and re-link hints ───────────────────────
RECORD_NAME_PROPERTY=name
RECORD_KEY_PROPERTY=external_id
CHILD_PARENT_HINT_PROPERTY=parent_external_id
ASSET_CHILD_HINT_PROPERTY=child_external_id

# ── Remediation (comma-separated: create_missing_association, archive_dangling_association, flag_records)
REMEDIATION_ACTIONS=flag_records
MAX_MUTATIONS_PER_RUN=100
MUTATION_ABORT_ORPHAN_RATE_PCT=50
MUTATION_BATCH_SIZE=100

# ── Fetch limits ─────────────────────────────────────────────────────────────
SEARCH_MAX_PAGES=100
ASSOCIATION_BATCH_SIZE=100

# ── Alert thresholds ─────────────────────────────────────────────────────────
ORPHAN_RATE_ALERT_THRESHOLD_PCT=5
ALERT_MIN_SEVERITY=medium

# ── Alerting webhooks (placeholders) ─────────────────────────────────────────
SLACK_ALERT_WEBHOOK_URL=https://hooks.example.com/slack/crm-integrity-alerts
ALERT_WEBHOOK_URL=https://alerts.example.com/ops/association-validator

# ── Optional: pin the run clock (ISO 8601) for reproducible tests ────────────
RUN_TIMESTAMP_OVERRIDE=

# ── n8n instance setting: Code nodes and expressions must be able to read $env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
